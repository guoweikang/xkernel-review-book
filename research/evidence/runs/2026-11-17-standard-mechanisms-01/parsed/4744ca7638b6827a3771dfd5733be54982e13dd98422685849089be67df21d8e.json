          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            969,
            972
          ],
          "style": "outer"
        },
        {
          "doc_text": " Certain constructs like [`Future`]s can only be used with _exclusive_ access,",
          "path": "doc",
          "range": [
            973,
            1054
          ],
          "style": "outer"
        },
