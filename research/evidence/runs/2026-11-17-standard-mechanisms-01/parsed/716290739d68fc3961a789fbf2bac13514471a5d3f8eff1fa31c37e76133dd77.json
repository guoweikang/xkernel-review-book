          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            3416,
            3419
          ],
          "style": "outer"
        },
        {
          "doc_text": " If `is_less` does not implement a total order the resulting order and return value are",
          "path": "doc",
          "range": [
            3420,
            3510
          ],
          "style": "outer"
        },
        {
          "doc_text": " unspecified. All original elements will remain in `v` and any possible modifications via",
