  "units": [
    {
      "ancestors": [],
      "attributes": [
        {
          "doc_text": " Provides intentionally-wrapped arithmetic on `T`.",
          "path": "doc",
          "range": [
            267,
            320
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            321,
            324
          ],
          "style": "outer"
        },
        {
          "doc_text": " Operations like `+` on `u32` values are intended to never overflow,",
          "path": "doc",
          "range": [
            325,
            396
          ],
          "style": "outer"
        },
        {
          "doc_text": " and in some debug configurations overflow is detected and results",
          "path": "doc",
          "range": [
            397,
            466
          ],
          "style": "outer"
        },
        {
          "doc_text": " in a panic. While most arithmetic falls into this category, some",
          "path": "doc",
          "range": [
            467,
            535
          ],
          "style": "outer"
        },
        {
          "doc_text": " code explicitly expects and relies upon modular arithmetic (e.g.,",
          "path": "doc",
          "range": [
            536,
            605
          ],
          "style": "outer"
        },
        {
          "doc_text": " hashing).",
          "path": "doc",
          "range": [
            606,
            619
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            620,
            623
          ],
          "style": "outer"
        },
        {
          "doc_text": " Wrapping arithmetic can be achieved either through methods like",
          "path": "doc",
          "range": [
            624,
            691
          ],
          "style": "outer"
        },
        {
          "doc_text": " `wrapping_add`, or through the `Wrapping<T>` type, which says that",
          "path": "doc",
          "range": [
            692,
            762
          ],
          "style": "outer"
        },
        {
          "doc_text": " all standard arithmetic operations on the underlying value are",
          "path": "doc",
          "range": [
            763,
            829
          ],
          "style": "outer"
        },
        {
          "doc_text": " intended to have wrapping semantics.",
          "path": "doc",
          "range": [
            830,
            870
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            871,
            874
          ],
          "style": "outer"
        },
        {
          "doc_text": " The underlying value can be retrieved through the `.0` index of the",
          "path": "doc",
          "range": [
            875,
            946
          ],
          "style": "outer"
        },
        {
          "doc_text": " `Wrapping` tuple.",
          "path": "doc",
          "range": [
            947,
            968
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            969,
            972
          ],
          "style": "outer"
        },
        {
          "doc_text": " # Examples",
          "path": "doc",
          "range": [
            973,
            987
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            988,
            991
          ],
          "style": "outer"
        },
        {
          "doc_text": " ```",
          "path": "doc",
          "range": [
            992,
            999
          ],
          "style": "outer"
        },
        {
          "doc_text": " use std::num::Wrapping;",
          "path": "doc",
          "range": [
            1000,
            1027
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            1028,
            1031
          ],
          "style": "outer"
        },
        {
          "doc_text": " let zero = Wrapping(0u32);",
          "path": "doc",
          "range": [
            1032,
            1062
          ],
          "style": "outer"
        },
        {
          "doc_text": " let one = Wrapping(1u32);",
          "path": "doc",
          "range": [
            1063,
            1092
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            1093,
            1096
          ],
          "style": "outer"
        },
        {
          "doc_text": " assert_eq!(u32::MAX, (zero - one).0);",
          "path": "doc",
          "range": [
            1097,
            1138
          ],
          "style": "outer"
        },
        {
          "doc_text": " ```",
          "path": "doc",
          "range": [
            1139,
            1146
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            1147,
            1150
          ],
          "style": "outer"
        },
        {
          "doc_text": " # Layout",
          "path": "doc",
          "range": [
            1151,
            1163
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            1164,
            1167
          ],
          "style": "outer"
        },
        {
          "doc_text": " `Wrapping<T>` is guaranteed to have the same layout and ABI as `T`.",
          "path": "doc",
          "range": [
            1168,
            1239
          ],
          "style": "outer"
        },
