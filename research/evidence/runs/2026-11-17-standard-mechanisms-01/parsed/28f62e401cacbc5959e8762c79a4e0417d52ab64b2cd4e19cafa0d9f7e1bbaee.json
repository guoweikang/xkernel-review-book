    },
    {
      "ancestors": [],
      "attributes": [
        {
          "doc_text": " A value that is known not to equal zero.",
          "path": "doc",
          "range": [
            2828,
            2872
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            2873,
            2876
          ],
          "style": "outer"
        },
        {
          "doc_text": " This enables some memory layout optimization.",
          "path": "doc",
          "range": [
            2877,
            2926
          ],
          "style": "outer"
        },
        {
          "doc_text": " For example, `Option<NonZero<u32>>` is the same size as `u32`:",
          "path": "doc",
          "range": [
            2927,
            2993
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            2994,
            2997
          ],
          "style": "outer"
        },
        {
          "doc_text": " ```",
          "path": "doc",
          "range": [
            2998,
            3005
          ],
          "style": "outer"
        },
        {
          "doc_text": " use core::{num::NonZero};",
          "path": "doc",
          "range": [
            3006,
            3035
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            3036,
            3039
          ],
          "style": "outer"
        },
        {
          "doc_text": " assert_eq!(size_of::<Option<NonZero<u32>>>(), size_of::<u32>());",
          "path": "doc",
          "range": [
            3040,
            3108
          ],
          "style": "outer"
        },
        {
          "doc_text": " ```",
          "path": "doc",
          "range": [
            3109,
            3116
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            3117,
            3120
          ],
          "style": "outer"
        },
        {
          "doc_text": " # Layout",
          "path": "doc",
          "range": [
            3121,
            3133
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            3134,
            3137
          ],
          "style": "outer"
        },
        {
          "doc_text": " `NonZero<T>` is guaranteed to have the same layout and bit validity as `T`",
          "path": "doc",
          "range": [
            3138,
            3216
          ],
          "style": "outer"
        },
        {
          "doc_text": " with the exception that the all-zero bit pattern is invalid.",
          "path": "doc",
          "range": [
            3217,
            3281
          ],
          "style": "outer"
        },
        {
          "doc_text": " `Option<NonZero<T>>` is guaranteed to be compatible with `T`, including in",
          "path": "doc",
          "range": [
            3282,
            3360
          ],
          "style": "outer"
        },
        {
          "doc_text": " FFI.",
          "path": "doc",
          "range": [
            3361,
            3369
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            3370,
            3373
          ],
          "style": "outer"
        },
        {
          "doc_text": " Thanks to the [null pointer optimization], `NonZero<T>` and",
          "path": "doc",
          "range": [
            3374,
            3437
          ],
          "style": "outer"
        },
        {
          "doc_text": " `Option<NonZero<T>>` are guaranteed to have the same size and alignment:",
          "path": "doc",
          "range": [
            3438,
            3514
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            3515,
            3518
          ],
          "style": "outer"
        },
        {
          "doc_text": " ```",
          "path": "doc",
          "range": [
            3519,
            3526
          ],
          "style": "outer"
        },
        {
          "doc_text": " use std::num::NonZero;",
          "path": "doc",
          "range": [
            3527,
            3553
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            3554,
            3557
          ],
          "style": "outer"
        },
        {
          "doc_text": " assert_eq!(size_of::<NonZero<u32>>(), size_of::<Option<NonZero<u32>>>());",
          "path": "doc",
          "range": [
            3558,
            3635
          ],
          "style": "outer"
        },
        {
          "doc_text": " assert_eq!(align_of::<NonZero<u32>>(), align_of::<Option<NonZero<u32>>>());",
          "path": "doc",
          "range": [
            3636,
            3715
          ],
          "style": "outer"
        },
        {
          "doc_text": " ```",
          "path": "doc",
          "range": [
            3716,
            3723
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            3724,
            3727
          ],
          "style": "outer"
        },
        {
          "doc_text": " [null pointer optimization]: crate::option#representation",
          "path": "doc",
          "range": [
            3728,
            3789
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            3790,
            3793
          ],
          "style": "outer"
        },
        {
          "doc_text": " # Note on generic usage",
          "path": "doc",
          "range": [
            3794,
            3821
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            3822,
            3825
          ],
          "style": "outer"
        },
        {
          "doc_text": " `NonZero<T>` can only be used with some standard library primitive types",
          "path": "doc",
          "range": [
            3826,
            3902
          ],
          "style": "outer"
        },
        {
          "doc_text": " (such as `u8`, `i32`, and etc.). The type parameter `T` must implement the",
          "path": "doc",
          "range": [
            3903,
            3981
          ],
          "style": "outer"
        },
        {
          "doc_text": " internal trait [`ZeroablePrimitive`], which is currently permanently unstable",
          "path": "doc",
          "range": [
            3982,
            4063
          ],
          "style": "outer"
        },
        {
          "doc_text": " and cannot be implemented by users. Therefore, you cannot use `NonZero<T>`",
          "path": "doc",
          "range": [
            4064,
            4142
          ],
          "style": "outer"
        },
        {
          "doc_text": " with your own types, nor can you implement traits for all `NonZero<T>`,",
          "path": "doc",
          "range": [
            4143,
            4218
          ],
          "style": "outer"
        },
        {
          "doc_text": " only for concrete types.",
          "path": "doc",
          "range": [
            4219,
            4247
          ],
          "style": "outer"
        },
        {
          "doc_text": null,
          "path": "stable",
          "range": [
            4248,
