      "attributes": [
        {
          "doc_text": " A marker trait for primitive types which can be zero.",
          "path": "doc",
          "range": [
            461,
            518
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            519,
            522
          ],
          "style": "outer"
        },
        {
          "doc_text": " This is an implementation detail for <code>[NonZero]\\<T></code> which may disappear or be replaced at any time.",
          "path": "doc",
          "range": [
            523,
            638
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            639,
            642
          ],
          "style": "outer"
        },
        {
          "doc_text": " # Safety",
          "path": "doc",
          "range": [
            643,
            655
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            656,
            659
          ],
          "style": "outer"
        },
        {
          "doc_text": " Types implementing this trait must be primitives that are valid when zeroed.",
          "path": "doc",
          "range": [
            660,
            740
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            741,
            744
          ],
          "style": "outer"
        },
        {
          "doc_text": " The associated `Self::NonZeroInner` type must have the same size+align as `Self`,",
          "path": "doc",
          "range": [
            745,
            830
          ],
          "style": "outer"
        },
        {
          "doc_text": " but with a niche and bit validity making it so the following `transmutes` are sound:",
          "path": "doc",
          "range": [
            831,
            919
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            920,
            923
          ],
          "style": "outer"
        },
        {
          "doc_text": " - `Self::NonZeroInner` to `Option<Self::NonZeroInner>`",
          "path": "doc",
          "range": [
            924,
            982
          ],
          "style": "outer"
        },
        {
          "doc_text": " - `Option<Self::NonZeroInner>` to `Self`",
          "path": "doc",
          "range": [
            983,
            1027
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            1028,
            1031
          ],
          "style": "outer"
        },
        {
          "doc_text": " (And, consequently, `Self::NonZeroInner` to `Self`.)",
          "path": "doc",
          "range": [
            1032,
            1088
          ],
          "style": "outer"
        },
        {
          "doc_text": null,
          "path": "unstable",
          "range": [
            1089,
            1242
          ],
          "style": "outer"
        }
      ],
