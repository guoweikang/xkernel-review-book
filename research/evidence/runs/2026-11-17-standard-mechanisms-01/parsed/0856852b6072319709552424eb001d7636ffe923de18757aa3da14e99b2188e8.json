            7138,
            7231
          ],
          "style": "outer"
        },
        {
          "doc_text": " field of `DynMetadata`. To work around that issue, we use `transmute` instead of using a",
          "path": "doc",
          "range": [
            7236,
            7328
          ],
          "style": "outer"
        },
        {
          "doc_text": " field projection.",
          "path": "doc",
          "range": [
            7333,
