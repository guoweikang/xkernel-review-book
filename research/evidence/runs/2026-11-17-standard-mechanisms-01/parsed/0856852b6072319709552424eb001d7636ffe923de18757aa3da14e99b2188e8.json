          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            5168,
            5171
          ],
          "style": "outer"
        },
        {
          "doc_text": " It is a pointer to a vtable (virtual call table)",
          "path": "doc",
          "range": [
            5172,
            5224
          ],
          "style": "outer"
        },
        {
          "doc_text": " that represents all the necessary information",
          "path": "doc",
          "range": [
            5225,
            5274
          ],
          "style": "outer"
        },
        {
          "doc_text": " to manipulate the concrete type stored inside a trait object.",
          "path": "doc",
          "range": [
            5275,
            5340
          ],
          "style": "outer"
        },
        {
          "doc_text": " The vtable notably contains:",
          "path": "doc",
          "range": [
            5341,
            5373
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            5374,
            5377
          ],
          "style": "outer"
        },
        {
          "doc_text": " * type size",
          "path": "doc",
          "range": [
            5378,
            5393
          ],
          "style": "outer"
        },
        {
          "doc_text": " * type alignment",
          "path": "doc",
          "range": [
            5394,
            5414
          ],
          "style": "outer"
        },
        {
          "doc_text": " * a pointer to the type’s `drop_in_place` impl (may be a no-op for plain-old-data)",
          "path": "doc",
          "range": [
            5415,
            5503
          ],
          "style": "outer"
        },
        {
          "doc_text": " * pointers to all the methods for the type’s implementation of the trait",
          "path": "doc",
          "range": [
            5504,
            5582
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            5583,
            5586
          ],
          "style": "outer"
        },
        {
          "doc_text": " Note that the first three are special because they’re necessary to allocate, drop,",
