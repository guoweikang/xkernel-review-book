          "range": [
            5587,
            5675
          ],
          "style": "outer"
        },
        {
          "doc_text": " and deallocate any trait object.",
          "path": "doc",
          "range": [
            5676,
            5712
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            5713,
            5716
          ],
          "style": "outer"
        },
        {
          "doc_text": " It is possible to name this struct with a type parameter that is not a `dyn` trait object",
