          "range": [
            2152,
            2206
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            2207,
            2210
          ],
          "style": "outer"
        },
        {
          "doc_text": " [`to_raw_parts`]: *const::to_raw_parts",
          "path": "doc",
          "range": [
            2211,
            2253
          ],
          "style": "outer"
        },
        {
          "doc_text": null,
          "path": "lang",
