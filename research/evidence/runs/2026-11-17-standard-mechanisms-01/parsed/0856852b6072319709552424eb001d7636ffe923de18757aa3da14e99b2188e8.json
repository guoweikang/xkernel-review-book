        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            5901,
            5904
          ],
          "style": "outer"
        },
        {
          "doc_text": " Note that while this type implements `PartialEq`, comparing vtable pointers is unreliable:",
          "path": "doc",
          "range": [
            5905,
            5999
          ],
          "style": "outer"
        },
        {
