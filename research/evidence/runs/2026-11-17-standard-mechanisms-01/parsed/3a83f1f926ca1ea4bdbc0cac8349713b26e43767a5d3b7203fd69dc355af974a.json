  "units": [
    {
      "ancestors": [],
      "attributes": [
        {
          "doc_text": " Parse the significant digits and biased, binary exponent of a float.",
          "path": "doc",
          "range": [
            238,
            310
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            311,
            314
          ],
          "style": "outer"
        },
        {
          "doc_text": " This is a fallback algorithm that uses a big-integer representation",
          "path": "doc",
          "range": [
            315,
            386
          ],
          "style": "outer"
        },
        {
          "doc_text": " of the float, and therefore is considerably slower than faster",
          "path": "doc",
          "range": [
            387,
            453
          ],
          "style": "outer"
        },
        {
          "doc_text": " approximations. However, it will always determine how to round",
          "path": "doc",
          "range": [
            454,
            520
          ],
          "style": "outer"
        },
        {
          "doc_text": " the significant digits to the nearest machine float, allowing",
          "path": "doc",
          "range": [
            521,
            586
          ],
          "style": "outer"
        },
        {
          "doc_text": " use to handle near half-way cases.",
          "path": "doc",
          "range": [
            587,
            625
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            626,
            629
          ],
          "style": "outer"
        },
        {
          "doc_text": " Near half-way cases are halfway between two consecutive machine floats.",
          "path": "doc",
          "range": [
            630,
            705
          ],
          "style": "outer"
        },
        {
          "doc_text": " For example, the float `16777217.0` has a bitwise representation of",
          "path": "doc",
          "range": [
            706,
            777
          ],
          "style": "outer"
        },
        {
          "doc_text": " `100000000000000000000000 1`. Rounding to a single-precision float,",
          "path": "doc",
          "range": [
            778,
            849
          ],
          "style": "outer"
        },
        {
          "doc_text": " the trailing `1` is truncated. Using round-nearest, tie-even, any",
          "path": "doc",
          "range": [
            850,
            919
          ],
          "style": "outer"
        },
        {
          "doc_text": " value above `16777217.0` must be rounded up to `16777218.0`, while",
          "path": "doc",
          "range": [
            920,
            990
          ],
          "style": "outer"
        },
        {
          "doc_text": " any value before or equal to `16777217.0` must be rounded down",
          "path": "doc",
          "range": [
            991,
            1057
          ],
          "style": "outer"
        },
        {
          "doc_text": " to `16777216.0`. These near-halfway conversions therefore may require",
          "path": "doc",
          "range": [
            1058,
            1131
          ],
          "style": "outer"
        },
        {
          "doc_text": " a large number of digits to unambiguously determine how to round.",
          "path": "doc",
          "range": [
            1132,
            1201
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            1202,
            1205
          ],
          "style": "outer"
        },
        {
          "doc_text": " The algorithms described here are based on \"Processing Long Numbers Quickly\",",
          "path": "doc",
          "range": [
            1206,
            1287
          ],
          "style": "outer"
        },
        {
          "doc_text": " available here: <https://arxiv.org/pdf/2101.11408.pdf#section.11>.",
          "path": "doc",
          "range": [
            1288,
            1358
          ],
          "style": "outer"
        }
      ],
