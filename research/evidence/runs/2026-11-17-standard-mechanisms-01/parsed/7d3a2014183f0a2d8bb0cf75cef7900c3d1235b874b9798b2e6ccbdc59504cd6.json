      ],
      "style": "inner"
    },
    {
      "doc_text": " # Stage masks",
      "path": "doc",
      "range": [
        1968,
        1985
      ],
      "style": "inner"
    },
    {
      "doc_text": "",
      "path": "doc",
      "range": [
        1986,
        1989
      ],
      "style": "inner"
    },
    {
      "doc_text": " To facilitate the shifts at each stage, we compute a mask that covers both",
      "path": "doc",
      "range": [
        1990,
