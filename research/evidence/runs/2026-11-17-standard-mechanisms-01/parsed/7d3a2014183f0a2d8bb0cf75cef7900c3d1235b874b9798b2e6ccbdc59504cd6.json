      ],
      "style": "inner"
    },
    {
      "doc_text": " # Deposition",
      "path": "doc",
      "range": [
        1619,
        1635
      ],
      "style": "inner"
    },
    {
      "doc_text": "",
      "path": "doc",
      "range": [
        1636,
        1639
      ],
      "style": "inner"
    },
    {
      "doc_text": " For `deposit_bits`, the stages are reversed. We start with a single run of",
      "path": "doc",
      "range": [
        1640,
        1718
      ],
      "style": "inner"
    },
    {
      "doc_text": " data in the low bits. Each stage then splits each run of data in two by",
      "path": "doc",
      "range": [
        1719,
        1794
      ],
      "style": "inner"
    },
    {
      "doc_text": " shifting part of it left by `n`, which is halved each stage.",
      "path": "doc",
      "range": [
        1795,
        1859
      ],
      "style": "inner"
    },
    {
      "doc_text": " ```text",
      "path": "doc",
      "range": [
        1860,
        1871
