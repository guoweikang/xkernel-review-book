          "path": "doc",
          "range": [
            4284,
            4287
          ],
          "style": "outer"
        },
        {
          "doc_text": " If an unwind would be unsound, then this function should be used in order",
          "path": "doc",
          "range": [
            4288,
            4365
          ],
          "style": "outer"
        },
        {
