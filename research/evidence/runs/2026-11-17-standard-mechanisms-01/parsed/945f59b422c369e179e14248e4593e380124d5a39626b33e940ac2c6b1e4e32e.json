        {
          "doc_text": "",
          "path": "doc",
          "range": [
            441,
            444
          ],
          "style": "outer"
        },
        {
          "doc_text": " If the element type of the iterator you need implements [`Clone`], and",
          "path": "doc",
          "range": [
            445,
            519
          ],
          "style": "outer"
        },
        {
          "doc_text": " it is OK to keep the source element in memory, you should instead use",
