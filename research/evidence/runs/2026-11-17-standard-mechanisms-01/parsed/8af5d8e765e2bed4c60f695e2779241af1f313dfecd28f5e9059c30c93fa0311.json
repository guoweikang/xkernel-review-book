      "attributes": [
        {
          "doc_text": " Returns an iterator that produces an escaped version of a `u8`.",
          "path": "doc",
          "range": [
            1015,
            1082
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            1083,
            1086
          ],
          "style": "outer"
        },
        {
          "doc_text": " The default is chosen with a bias toward producing literals that are",
          "path": "doc",
          "range": [
            1087,
            1159
          ],
          "style": "outer"
        },
        {
          "doc_text": " legal in a variety of languages, including C++11 and similar C-family",
          "path": "doc",
          "range": [
            1160,
            1233
          ],
          "style": "outer"
        },
        {
          "doc_text": " languages. The exact rules are:",
          "path": "doc",
          "range": [
            1234,
            1269
          ],
          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            1270,
            1273
          ],
          "style": "outer"
        },
        {
          "doc_text": " * Tab is escaped as `\\t`.",
          "path": "doc",
          "range": [
            1274,
            1303
          ],
          "style": "outer"
        },
        {
          "doc_text": " * Carriage return is escaped as `\\r`.",
          "path": "doc",
          "range": [
            1304,
            1345
          ],
          "style": "outer"
        },
        {
          "doc_text": " * Line feed is escaped as `\\n`.",
          "path": "doc",
          "range": [
            1346,
            1381
          ],
          "style": "outer"
        },
        {
          "doc_text": " * Single quote is escaped as `\\'`.",
          "path": "doc",
          "range": [
            1382,
            1420
          ],
          "style": "outer"
        },
        {
          "doc_text": " * Double quote is escaped as `\\\"`.",
          "path": "doc",
          "range": [
            1421,
            1459
          ],
          "style": "outer"
        },
        {
          "doc_text": " * Backslash is escaped as `\\\\`.",
          "path": "doc",
          "range": [
            1460,
            1495
          ],
          "style": "outer"
        },
        {
          "doc_text": " * Any character in the 'printable ASCII' range `0x20` .. `0x7e`",
          "path": "doc",
          "range": [
            1496,
            1563
          ],
          "style": "outer"
        },
        {
          "doc_text": "   inclusive is not escaped.",
          "path": "doc",
          "range": [
            1564,
            1595
          ],
          "style": "outer"
        },
        {
          "doc_text": " * Any other chars are given hex escapes of the form '\\xNN'.",
          "path": "doc",
          "range": [
            1596,
            1659
          ],
          "style": "outer"
        },
        {
          "doc_text": " * Unicode escapes are never generated by this function.",
          "path": "doc",
