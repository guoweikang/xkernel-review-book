      "style": "inner"
    },
    {
      "doc_text": "",
      "path": "doc",
      "range": [
        567,
        570
      ],
      "style": "inner"
    },
    {
      "doc_text": " The core library cannot define any panic handler, but it can invoke it.",
      "path": "doc",
      "range": [
        571,
        646
      ],
      "style": "inner"
    },
    {
