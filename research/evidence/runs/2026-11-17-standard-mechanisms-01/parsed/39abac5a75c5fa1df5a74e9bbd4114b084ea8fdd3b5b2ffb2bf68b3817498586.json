          "style": "outer"
        },
        {
          "doc_text": "",
          "path": "doc",
          "range": [
            349,
            352
          ],
          "style": "outer"
        },
        {
          "doc_text": " If you know the number of repetitions in advance, consider using [`repeat_n()`]",
          "path": "doc",
          "range": [
            353,
            436
          ],
          "style": "outer"
        },
        {
          "doc_text": " instead, as it is more efficient and conveys the intent more clearly.",
