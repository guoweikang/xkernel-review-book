        {
          "doc_text": "",
          "path": "doc",
          "range": [
            399,
            402
          ],
          "style": "outer"
        },
        {
          "doc_text": " Calling next on a fused iterator that has returned `None` once is guaranteed",
          "path": "doc",
          "range": [
            403,
            483
          ],
          "style": "outer"
        },
        {
          "doc_text": " to return [`None`] again. This trait should be implemented by all iterators",
          "path": "doc",
