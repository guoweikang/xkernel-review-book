},{"binder_candidate":null,"candidate_status":"not_a_local_use","node_id":68,"normalized_name":"flags","role":"method_name","scope_id":1,"spelling":"flags"},{"binder_candidate":null,"candidate_status":"not_a_local_use","node_id":69,"normalized_name":"contains","role":"method_name","scope_id":1,"spelling":"contains"},{"binder_candidate":null,"candidate_status":"unknown_scope","node_id":71,"normalized_name":"flags","role":"local_use","scope_id":1,"spelling":"flags"},{"binder_candidate":null,"candidate_status":"unknown_scope","node_id":76,"normalized_name":"Ok","role":"local_use","scope_id":2,"spelling":"Ok"},{"binder_candidate":null,"candidate_status":"unknown_scope","node_id":80,"normalized_name":"self","role":"local_use","scope_id":2,"spelling":"self"},{"binder_candidate":null,"candidate_status":"not_a_local_use","node_id":81,"normalized_name":"mount","role":"method_name","scope_id":2,"spelling":"mount"},{"binder_candidate":null,"candidate_status":"not_a_local_use","node_id":82,"normalized_name":"clone","role":"method_name","scope_id":2,"spelling":"clone"},{"binder_candidate":null,"candidate_status":"not_a_local_use","node_id":85,"normalized_name":"mount","role":"let_binder","scope_id":1,"spelling":"mount"},{"binder_candidate":null,"candidate_status":"unknown_scope","node_id":88,"normalized_name":"self","role":"local_use","scope_id":1,"spelling":"self"},{"binder_candidate":null,"candidate_status":"not_a_local_use","node_id":89,"normalized_name":"graft_tree","role":"method_name","scope_id":1,"spelling":"graft_tree"},{"binder_candidate":null,"candidate_status":"unknown_scope","node_id":91,"normalized_name":"mount","role":"local_use","scope_id":1,"spelling":"mount"}],"resolved_edges":0,"root_id":0,"schema":"rust-structure-subset/1","scopes":[{"kind":"function","parent_id":null,"scope_id":0,"unknown_binding_effects":false},{"kind":"block","parent_id":0,"scope_id":1,"unknown_binding_effects":true},{"kind":"block","parent_id":1,"scope_id":2,"unknown_binding_effects":false}],"signature_semantics":"not_evaluated","source_text":"fn mount_filesystem_with_requested_superblock_flags(\n        &self,\n        fs: &Arc<SuperBlock>,\n        flags: MountFlags,\n        devname: Option<&str>,\n        requested_superblock_flags: Option<SuperBlockFlags>,\n    ) -> VfsResult<Arc<Mount>> {\n        // A second mount of the same superblock at its own root cannot make\n        // any new filesystem state visible, but stacking it would hide every\n        // child mount attached below the existing mount. Keep the existing\n        // mount when it is at least as restrictive as the request; otherwise\n        // let the new mount replace it so stricter flags take effect. A\n        // request for looser flags is left to MS_REMOUNT rather than silently\n        // weakening the live mount. A bind mount of a subdirectory is not the\n        // superblock root, so it is always replaced by a full-filesystem mount.\n        if requested_superblock_flags.is_none_or(|flags| flags.is_empty())\n            && self.is_mount_root()\n            && Arc::ptr_eq(self.mount().super_block(), fs)\n            && self.mount().root_path().dentry.ptr_eq(&fs.root_dir())\n            && self.mount().flags().contains(flags)\n        {\n            return Ok(self.mount().clone());\n        }\n        let mount = Mount::try_new_detached(fs, flags, devname, requested_superblock_flags)?\n            .ok_or(VfsError::ResourceBusy)?;\n        self.graft_tree(mount)\n    }","status":"parsed"}
