{"binders":[{"binder_id":0,"node_id":4,"normalized_name":"self","scope_id":0,"spelling":"self"},{"binder_id":1,"node_id":6,"normalized_name":"fs","scope_id":0,"spelling":"fs"},{"binder_id":2,"node_id":9,"normalized_name":"flags","scope_id":0,"spelling":"flags"},{"binder_id":3,"node_id":12,"normalized_name":"devname","scope_id":0,"spelling":"devname"},{"binder_id":4,"node_id":15,"normalized_name":"requested_superblock_flags","scope_id":0,"spelling":"requested_superblock_flags"},{"binder_id":5,"node_id":85,"normalized_name":"mount","scope_id":1,"spelling":"mount"}],"binding_semantics":"lexical_candidates_only_not_rust_resolution","body_node_id":18,"cfg":"not_evaluated","coverage":{"complete_supported":false,"domain":"exported_body_subset_not_full_rust_ast","exported_tree_closed":false,"lexical_scopes_without_unknown_effects":false,"unsupported_nodes":8},"nodes":[{"coverage":"supported","node_id":0,"ordered_children":[1,18],"parent_id":null,"range":[0,1402],"role":"root","scope_id":0,"source_text":"fn mount_filesystem_with_requested_superblock_flags(\n        &self,\n        fs: &Arc<SuperBlock>,\n        flags: MountFlags,\n        devname: Option<&str>,\n        requested_superblock_flags: Option<SuperBlockFlags>,\n    ) -> VfsResult<Arc<Mount>> {\n        // A second mount of the same superblock at its own root cannot make\n        // any new filesystem state visible, but stacking it would hide every\n        // child mount attached below the existing mount. Keep the existing\n        // mount when it is at least as restrictive as the request; otherwise\n        // let the new mount replace it so stricter flags take effect. A\n        // request for looser flags is left to MS_REMOUNT rather than silently\n        // weakening the live mount. A bind mount of a subdirectory is not the\n        // superblock root, so it is always replaced by a full-filesystem mount.\n        if requested_superblock_flags.is_none_or(|flags| flags.is_empty())\n            && self.is_mount_root()\n            && Arc::ptr_eq(self.mount().super_block(), fs)\n            && self.mount().root_path().dentry.ptr_eq(&fs.root_dir())\n            && self.mount().flags().contains(flags)\n        {\n            return Ok(self.mount().clone());\n        }\n        let mount = Mount::try_new_detached(fs, flags, devname, requested_superblock_flags)?\n            .ok_or(VfsError::ResourceBusy)?;\n        self.graft_tree(mount)\n    }","subtree_closed":false,"syntax_kind":"function"},{"coverage":"supported","node_id":1,"ordered_children":[2,3,5,8,11,14,17],"parent_id":0,"range":[0,247],"role":"signature","scope_id":0,"source_text":"fn mount_filesystem_with_requested_superblock_flags(\n        &self,\n        fs: &Arc<SuperBlock>,\n        flags: MountFlags,\n        devname: Option<&str>,\n        requested_superblock_flags: Option<SuperBlockFlags>,\n    ) -> VfsResult<Arc<Mount>>","subtree_closed":false,"syntax_kind":"signature"},{"coverage":"supported","node_id":2,"ordered_children":[],"parent_id":1,"range":[3,51],"role":"function_name","scope_id":0,"source_text":"mount_filesystem_with_requested_superblock_flags","subtree_closed":true,"syntax_kind":"identifier"},{"coverage":"supported","node_id":3,"ordered_children":[4],"parent_id":1,"range":[61,66],"role":"parameter","scope_id":0,"source_text":"&self","subtree_closed":true,"syntax_kind":"parameter"},{"coverage":"supported","node_id":4,"ordered_children":[],"parent_id":3,"range":[62,66],"role":"parameter_binder","scope_id":0,"source_text":"self","subtree_closed":true,"syntax_kind":"identifier"},{"coverage":"supported","node_id":5,"ordered_children":[6,7],"parent_id":1,"range":[76,96],"role":"parameter","scope_id":0,"source_text":"fs: &Arc<SuperBlock>","subtree_closed":false,"syntax_kind":"parameter"},{"coverage":"supported","node_id":6,"ordered_children":[],"parent_id":5,"range":[76,78],"role":"parameter_binder","scope_id":0,"source_text":"fs","subtree_closed":true,"syntax_kind":"identifier"},{"coverage":"opaque"