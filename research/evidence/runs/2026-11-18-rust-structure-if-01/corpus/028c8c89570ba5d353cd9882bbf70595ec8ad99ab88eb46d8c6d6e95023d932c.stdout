d":1,"spelling":"dentry"},{"binder_candidate":null,"candidate_status":"not_a_local_use","node_id":80,"normalized_name":"is_some_and","role":"method_name","scope_id":1,"spelling":"is_some_and"},{"binder_candidate":null,"candidate_status":"unknown_scope","node_id":86,"normalized_name":"Err","role":"local_use","scope_id":4,"spelling":"Err"},{"binder_candidate":null,"candidate_status":"unknown_scope","node_id":94,"normalized_name":"self","role":"local_use","scope_id":1,"spelling":"self"},{"binder_candidate":null,"candidate_status":"not_a_local_use","node_id":95,"normalized_name":"mnt","role":"field_name","scope_id":1,"spelling":"mnt"},{"binder_candidate":null,"candidate_status":"not_a_local_use","node_id":96,"normalized_name":"covers","role":"field_name","scope_id":1,"spelling":"covers"},{"binder_candidate":null,"candidate_status":"not_a_local_use","node_id":97,"normalized_name":"lock","role":"method_name","scope_id":1,"spelling":"lock"},{"binder_candidate":null,"candidate_status":"not_a_local_use","node_id":98,"normalized_name":"take","role":"method_name","scope_id":1,"spelling":"take"},{"binder_candidate":null,"candidate_status":"not_a_local_use","node_id":99,"normalized_name":"covered","role":"let_binder","scope_id":1,"spelling":"covered"},{"binder_candidate":null,"candidate_status":"unknown_scope","node_id":104,"normalized_name":"Ok","role":"local_use","scope_id":1,"spelling":"Ok"}],"resolved_edges":0,"root_id":0,"schema":"rust-structure-subset/1","scopes":[{"kind":"function","parent_id":null,"scope_id":0,"unknown_binding_effects":false},{"kind":"block","parent_id":0,"scope_id":1,"unknown_binding_effects":true},{"kind":"block","parent_id":1,"scope_id":2,"unknown_binding_effects":false},{"kind":"block","parent_id":1,"scope_id":3,"unknown_binding_effects":false},{"kind":"block","parent_id":1,"scope_id":4,"unknown_binding_effects":false}],"signature_semantics":"not_evaluated","source_text":"fn detach_mount_subtree(&self, mounts: &[Arc<Mount>]) -> VfsResult<()> {\n        if !self.dentry.ptr_eq(&self.mnt.mnt.mnt_root) {\n            return Err(VfsError::InvalidInput);\n        }\n        if !mounts\n            .first()\n            .is_some_and(|root| Arc::ptr_eq(root, &self.mnt))\n        {\n            return Err(VfsError::InvalidInput);\n        }\n\n        let parent_path = self.mnt.location().ok_or(VfsError::InvalidInput)?;\n        let inode = parent_path.inode();\n        let _namespace_guard = inode.lock_namespace_exclusive();\n        if !parent_path\n            .mnt\n            .child_mount_at(&parent_path.dentry)\n            .is_some_and(|mount| Arc::ptr_eq(&mount, &self.mnt))\n        {\n            return Err(VfsError::InvalidInput);\n        }\n\n        let covered = self.mnt.covers.lock().take();\n        match covered {\n            Some(ref mount) => {\n                parent_path\n                    .mnt\n                    .install_child_mount(&parent_path.dentry, mount);\n            }\n            None => parent_path.mnt.remove_child_mount(&parent_path.dentry),\n        }\n\n        // All fallible checks complete before this commit phase. The namespace\n        // entry point also validates registry membership for every layer. The\n        // remaining operations are infallible, so an overmount cannot be\n        // restored halfway and leave stale registry entries.\n        for mount in mounts {\n            mount.mnt_mounts.lock().clear();\n            mount.covers.lock().take();\n            mount.detach();\n        }\n        Ok(())\n    }","status":"parsed"}
