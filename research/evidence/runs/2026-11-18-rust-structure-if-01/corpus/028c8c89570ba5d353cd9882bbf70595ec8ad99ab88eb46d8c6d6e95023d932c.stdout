{"binders":[{"binder_id":0,"node_id":4,"normalized_name":"self","scope_id":0,"spelling":"self"},{"binder_id":1,"node_id":6,"normalized_name":"mounts","scope_id":0,"spelling":"mounts"},{"binder_id":2,"node_id":52,"normalized_name":"parent_path","scope_id":1,"spelling":"parent_path"},{"binder_id":3,"node_id":58,"normalized_name":"inode","scope_id":1,"spelling":"inode"},{"binder_id":4,"node_id":64,"normalized_name":"_namespace_guard","scope_id":1,"spelling":"_namespace_guard"},{"binder_id":5,"node_id":99,"normalized_name":"covered","scope_id":1,"spelling":"covered"}],"binding_semantics":"lexical_candidates_only_not_rust_resolution","body_node_id":9,"cfg":"not_evaluated","coverage":{"complete_supported":false,"domain":"exported_body_subset_not_full_rust_ast","exported_tree_closed":false,"lexical_scopes_without_unknown_effects":false,"unsupported_nodes":10},"nodes":[{"coverage":"supported","node_id":0,"ordered_children":[1,9],"parent_id":null,"range":[0,1570],"role":"root","scope_id":0,"source_text":"fn detach_mount_subtree(&self, mounts: &[Arc<Mount>]) -> VfsResult<()> {\n        if !self.dentry.ptr_eq(&self.mnt.mnt.mnt_root) {\n            return Err(VfsError::InvalidInput);\n        }\n        if !mounts\n            .first()\n            .is_some_and(|root| Arc::ptr_eq(root, &self.mnt))\n        {\n            return Err(VfsError::InvalidInput);\n        }\n\n        let parent_path = self.mnt.location().ok_or(VfsError::InvalidInput)?;\n        let inode = parent_path.inode();\n        let _namespace_guard = inode.lock_namespace_exclusive();\n        if !parent_path\n            .mnt\n            .child_mount_at(&parent_path.dentry)\n            .is_some_and(|mount| Arc::ptr_eq(&mount, &self.mnt))\n        {\n            return Err(VfsError::InvalidInput);\n        }\n\n        let covered = self.mnt.covers.lock().take();\n        match covered {\n            Some(ref mount) => {\n                parent_path\n                    .mnt\n                    .install_child_mount(&parent_path.dentry, mount);\n            }\n            None => parent_path.mnt.remove_child_mount(&parent_path.dentry),\n        }\n\n        // All fallible checks complete before this commit phase. The namespace\n        // entry point also validates registry membership for every layer. The\n        // remaining operations are infallible, so an overmount cannot be\n        // restored halfway and leave stale registry entries.\n        for mount in mounts {\n            mount.mnt_mounts.lock().clear();\n            mount.covers.lock().take();\n            mount.detach();\n        }\n        Ok(())\n    }","subtree_closed":false,"syntax_kind":"function"},{"coverage":"supported","node_id":1,"ordered_children":[2,3,5,8],"parent_id":0,"range":[0,70],"role":"signature","scope_id":0,"source_text":"fn detach_mount_subtree(&self, mounts: &[Arc<Mount>]) -> VfsResult<()>","subtree_closed":false,"syntax_kind":"signature"},{"coverage":"supported","node_id":2,"ordered_children":[],"parent_id":1,"range":[3,23],"role":"function_name","scope_id":0,"source_text":"detach_mount_subtree","subtree_closed":true,"syntax_kind":"identifier"},{"coverage":"supported","node_id":3,"ordered_children":[4],"parent_id":1,"range":[24,29],"role":"parameter","scope_id":0,"source_text":"&self","subtree_closed":true,"syntax_kind":"parameter"},{"coverage":"supported","node_id":4,"ordered_children":[],"parent_id":3,"range":[25,29],"role":"parameter_binder","scope_id":0,"source_text":"self","subtree_closed":true,"syntax_kind":"identifier"},{"coverage":"supported","node_id":5,"ordered_children":[6,7],"parent_id":1,"range":[31,52],"role":"parameter","scope_id":0,"source_text":"mounts: &[Arc<Mount>]","subtree_closed":false,"syntax_kind":"parameter"},{"coverage":"supported","node_id":6,"ordered_children":[],"parent_id":5,"range":[31,37],"role":"parameter_binder","scope_id":0,"source_text":"mounts","subtree_closed":true,"syntax_kind":"identifier"},{"coverage":"opaque","node_id":7,"ordered_children":