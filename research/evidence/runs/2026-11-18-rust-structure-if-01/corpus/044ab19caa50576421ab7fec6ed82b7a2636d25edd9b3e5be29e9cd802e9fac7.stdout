id);\n            if permission.contains(NodePermission::GROUP_EXEC) || !old_group_ok {\n                result.remove(NodePermission::SET_GID);\n            }\n        }\n        if result.bits() != permission.bits()\n            && new_gid.is_some_and(|gid| !cred.has_cap(kcred::CAP_FSETID) && !cred.in_group(gid))\n        {\n            result.remove(NodePermission::SET_GID);\n        }\n        result\n    }","status":"parsed"}
