        "start_line": 1185,
        "end_line": 1205,
        "sha256": "2005195e24e82114952be70b2b186d1c4de6cabd98a37a71d737e2680ce6012e",
        "source_sha256": "07f8982d385625a3b730c2329dc9cf983a6dfd75854f5bda85e3668af85f2cdd",
        "original_range": [
          41932,
          43689
        ],
        "attributes": [
          {
            "path": "doc",
            "range": [
              41932,
              42002
            ],
            "source": "/// Computes the mode bits Linux leaves after changing a node's owner."
          },
          {
            "path": "doc",
            "range": [
              42007,
              42010
            ],
            "source": "///"
          },
          {
            "path": "doc",
            "range": [
              42015,
              42085
            ],
            "source": "/// `chown_common()` excludes directories from the set-ID cleanup. For"
          },
          {
            "path": "doc",
            "range": [
              42090,
              42144
            ],
            "source": "/// other node types it always clears set-UID and asks"
          },
          {
            "path": "doc",
            "range": [
              42149,
              42222
            ],
            "source": "/// `setattr_should_drop_sgid()` whether set-GID must also go: set-GID is"
          },
          {
            "path": "doc",
            "range": [
              42227,
              42299
            ],
            "source": "/// dropped when group-execute is set or when the pre-chown GID is not a"
          },
          {
            "path": "doc",
            "range": [
              42304,
              42365
            ],
            "source": "/// member group and the caller lacks effective `CAP_FSETID`."
          },
          {
            "path": "doc",
            "range": [
              42370,
              42373
            ],
            "source": "///"
          },
          {
            "path": "doc",
            "range": [
              42378,
              42442
            ],
            "source": "/// When that cleanup actually changes a bit, Linux generates an"
          },
          {
            "path": "doc",
            "range": [
              42447,
              42517
            ],
            "source": "/// `ATTR_MODE` update. `setattr_prepare()` then clears set-GID if the"
          },
          {
            "path": "doc",
            "range": [
              42522,
              42597
            ],
            "source": "/// caller is not in the *new* GID and lacks `CAP_FSETID`; `setattr_copy()`"
          },
          {
            "path": "doc",
            "range": [
              42602,
              42676
            ],
            "source": "/// repeats that check against the updated inode. Apply the same condition"
          },
          {
            "path": "doc",
            "range": [
              42681,
              42751
            ],
            "source": "/// only on a generated mode change: a GID-only chown that leaves both"
          },
          {
            "path": "doc",
            "range": [
              42756,
              42818
            ],
            "source": "/// set-ID bits untouched does not pass through the mode path."
          }
        ],
